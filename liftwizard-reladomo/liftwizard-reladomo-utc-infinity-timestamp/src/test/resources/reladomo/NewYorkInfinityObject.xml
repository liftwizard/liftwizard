<MithraObject
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/goldmansachs/reladomo/master/reladomogen/src/main/xsd/mithraobject.xsd"
        objectType="transactional">

    <PackageName>io.liftwizard.reladomo.utc.infinity.timestamp.model</PackageName>
    <ClassName>NewYorkInfinityObject</ClassName>
    <DefaultTable>NEW_YORK_INFINITY_OBJECT</DefaultTable>

    <!-- 253399726740000 is 9999-12-02T04:59:00Z, the wall clock 9999-12-01 23:59:00 in America/New_York. -->
    <!-- It is Reladomo's DefaultInfinityTimestamp in a JVM whose default time zone is America/New_York. -->
    <AsOfAttribute
            name="system"
            fromColumnName="system_from"
            toColumnName="system_to"
            toIsInclusive="false"
            infinityDate="[new com.gs.fw.common.mithra.util.MithraTimestamp(253399726740000L, false)]"
            defaultIfNotSpecified="[new com.gs.fw.common.mithra.util.MithraTimestamp(253399726740000L, false)]"
            isProcessingDate="true"
            timezoneConversion="convert-to-utc" />

    <Attribute name="id" javaType="long" columnName="id" primaryKey="true" />
    <Attribute name="createdOn" javaType="Timestamp" columnName="created_on" timezoneConversion="convert-to-utc" />

</MithraObject>
