<MithraObject
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/goldmansachs/reladomo/master/reladomogen/src/main/xsd/mithraobject.xsd"
        objectType="transactional">

    <PackageName>io.liftwizard.reladomo.utc.infinity.timestamp.model</PackageName>
    <ClassName>UtcCompliantObject</ClassName>
    <DefaultTable>UTC_COMPLIANT_OBJECT</DefaultTable>

    <AsOfAttribute
            name="system"
            fromColumnName="system_from"
            toColumnName="system_to"
            toIsInclusive="false"
            infinityDate="[io.liftwizard.reladomo.utc.infinity.timestamp.UtcInfinityTimestamp.getDefaultInfinity()]"
            defaultIfNotSpecified="[io.liftwizard.reladomo.utc.infinity.timestamp.UtcInfinityTimestamp.getDefaultInfinity()]"
            isProcessingDate="true"
            timezoneConversion="convert-to-utc" />

    <Attribute name="id" javaType="long" columnName="id" primaryKey="true" />
    <Attribute name="createdOn" javaType="Timestamp" columnName="created_on" timezoneConversion="convert-to-utc" />

</MithraObject>
