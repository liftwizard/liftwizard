# Hand-written stand-in for the finder, type, and query schema that Klass generates.

input _ItemFinder {
    AND: [_ItemFinder!]
    OR:  [_ItemFinder!]
    id: _LongAttribute
    name: _StringAttribute
    createdOn: _DateAttribute
    updatedAt: _TimestampAttribute
}

type Item {
    id: Long!
    name: String
    createdOn: LocalDate
    updatedAt: Instant
}

type Query {
    itemByFinder(operation: _ItemFinder!): [Item!]!
}
